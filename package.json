{
	"name": "opengarlic",
	"version": "1.0.0",
	"private": true,
	"description": "OpenGarlic monorepo - server, client, and shared workspaces",
	"engines": {
		"node": ">=20.19.0"
	},
	"workspaces": [
		"server",
		"client",
		"packages/*"
	],
	"scripts": {
		"start": "npm run start -w server",
		"build": "env-cmd --use-shell \"npm run build -w client\"",
		"dev-server": "npm run dev-server -w server",
		"dev-client": "env-cmd --use-shell \"npm run start -w client\"",
		"dev": "concurrently --kill-others-on-fail \"npm run dev-server\" \"npm run dev-client\""
	},
	"devDependencies": {
		"concurrently": "^10.0.5",
		"env-cmd": "^11.0.0"
	},
	"overrides": {
		"nth-check": "2.1.1"
	}
}
